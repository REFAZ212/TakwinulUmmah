# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takwinul_ummah_db?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- App ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- Cloudinary (optional; falls back to local /uploads storage) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
