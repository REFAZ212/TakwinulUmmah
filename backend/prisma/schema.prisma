// ============================================================
// Yayasan Takwinul Ummah — Prisma Schema
// Covers: Foundation (Yayasan), Pesantren, SMP, SMA under one
// unified CMS with RBAC, content modules, and SEO metadata.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH / RBAC
// ------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  ADMIN_YAYASAN
  ADMIN_SMP
  ADMIN_SMA
  EDITOR
  GUEST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  activityLogs ActivityLog[]
  newsAuthored News[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique // e.g. "news.create", "admissions.export"
  label     String
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "CREATE_NEWS", "DELETE_TEACHER"
  entity    String   // e.g. "News", "Teacher"
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// ------------------------------------------------------------
// INSTITUTIONAL UNITS
// ------------------------------------------------------------

enum UnitType {
  FOUNDATION
  PESANTREN
  SMP
  SMA
}

model Foundation {
  id           String        @id @default(cuid())
  legalName    String
  shortName    String
  legalNumber  String?       // Akta Notaris / SK Kemenkumham
  address      String
  phone        String
  whatsapp     String?
  email        String
  history      String        @db.Text
  logoMediaId  String?
  logo         Media?        @relation("FoundationLogo", fields: [logoMediaId], references: [id])
  faviconUrl   String?
  visionMission VisionMission?
  chairman     Chairman?
  boardMembers BoardMember[]
  settings     Setting?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Chairman {
  id           String     @id @default(cuid())
  foundationId String     @unique
  foundation   Foundation @relation(fields: [foundationId], references: [id])
  name         String
  education    String?
  biography    String     @db.Text
  photoMediaId String?
  photo        Media?     @relation(fields: [photoMediaId], references: [id])
  socialLinks  Json?      // { instagram, facebook, youtube }
}

model BoardMember {
  id           String     @id @default(cuid())
  foundationId String
  foundation   Foundation @relation(fields: [foundationId], references: [id])
  name         String
  position     String
  photoMediaId String?
  photo        Media?     @relation(fields: [photoMediaId], references: [id])
  order        Int        @default(0)
}

model Pesantren {
  id            String   @id @default(cuid())
  name          String
  history       String   @db.Text
  logoMediaId   String?
  logo          Media?   @relation("PesantrenLogo", fields: [logoMediaId], references: [id])
  visionMission VisionMission?
  programs      Program[]
  facilities    Facility[]  @relation("PesantrenFacilities")
  teachers      Teacher[]   @relation("PesantrenTeachers")
  leaderId      String?
  leader        Principal?  @relation("PesantrenLeader", fields: [leaderId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Program {
  id          String    @id @default(cuid())
  pesantrenId String
  pesantren   Pesantren @relation(fields: [pesantrenId], references: [id])
  name        String    // Tahfidz, Madrasah Diniyah, etc
  description String    @db.Text
  order       Int       @default(0)
}

model SMP {
  id            String   @id @default(cuid())
  name          String
  about         String   @db.Text
  logoMediaId   String?
  logo          Media?   @relation("SMPLogo", fields: [logoMediaId], references: [id])
  visionMission VisionMission?
  principalId   String?
  principal     Principal? @relation("SMPPrincipal", fields: [principalId], references: [id])
  vicePrincipals Principal[] @relation("SMPVicePrincipals")
  teachers      Teacher[]   @relation("SMPTeachers")
  academicPrograms AcademicProgram[] @relation("SMPAcademic")
  extracurriculars Extracurricular[] @relation("SMPExtracurricular")
  facilities    Facility[]  @relation("SMPFacilities")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SMA {
  id            String   @id @default(cuid())
  name          String
  about         String   @db.Text
  logoMediaId   String?
  logo          Media?   @relation("SMALogo", fields: [logoMediaId], references: [id])
  visionMission VisionMission?
  principalId   String?
  principal     Principal? @relation("SMAPrincipal", fields: [principalId], references: [id])
  teachers      Teacher[]   @relation("SMATeachers")
  departments   Department[]
  academicPrograms AcademicProgram[] @relation("SMAAcademic")
  extracurriculars Extracurricular[] @relation("SMAExtracurricular")
  facilities    Facility[]  @relation("SMAFacilities")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id          String @id @default(cuid())
  smaId       String
  sma         SMA    @relation(fields: [smaId], references: [id])
  name        String // IPA, IPS
  description String @db.Text
}

model AcademicProgram {
  id          String  @id @default(cuid())
  name        String
  description String  @db.Text
  smpId       String?
  smp         SMP?    @relation("SMPAcademic", fields: [smpId], references: [id])
  smaId       String?
  sma         SMA?    @relation("SMAAcademic", fields: [smaId], references: [id])
}

model Extracurricular {
  id     String  @id @default(cuid())
  name   String
  smpId  String?
  smp    SMP?    @relation("SMPExtracurricular", fields: [smpId], references: [id])
  smaId  String?
  sma    SMA?    @relation("SMAExtracurricular", fields: [smaId], references: [id])
}

// Separate Vision/Mission management per unit (Foundation / Pesantren / SMP / SMA)
model VisionMission {
  id           String      @id @default(cuid())
  unitType     UnitType    @unique
  vision       String      @db.Text
  mission      String      @db.Text
  goals        String?     @db.Text
  values       String?     @db.Text

  foundationId String?     @unique
  foundation   Foundation? @relation(fields: [foundationId], references: [id])
  pesantrenId  String?     @unique
  pesantren    Pesantren?  @relation(fields: [pesantrenId], references: [id])
  smpId        String?     @unique
  smp          SMP?        @relation(fields: [smpId], references: [id])
  smaId        String?     @unique
  sma          SMA?        @relation(fields: [smaId], references: [id])
}

// ------------------------------------------------------------
// PEOPLE (Teachers / Principals)
// ------------------------------------------------------------

model Principal {
  id          String   @id @default(cuid())
  name        String
  position    String   // "Kepala Sekolah", "Wakil Kepala Kurikulum"...
  education   String?
  biography   String?  @db.Text
  photoMediaId String?
  photo       Media?   @relation(fields: [photoMediaId], references: [id])
  socialLinks Json?

  pesantrenLeaderOf Pesantren[] @relation("PesantrenLeader")
  smpPrincipalOf    SMP[]       @relation("SMPPrincipal")
  smpViceOf         SMP[]       @relation("SMPVicePrincipals")
  smaPrincipalOf    SMA[]       @relation("SMAPrincipal")

  createdAt   DateTime @default(now())
}

model Teacher {
  id           String    @id @default(cuid())
  name         String
  position     String    // subject / role, e.g. "Guru Matematika", "Musyrif Asrama"
  education    String?
  biography    String?   @db.Text
  photoMediaId String?
  photo        Media?    @relation(fields: [photoMediaId], references: [id])
  socialLinks  Json?
  unitType     UnitType

  pesantrenId  String?
  pesantren    Pesantren? @relation("PesantrenTeachers", fields: [pesantrenId], references: [id])
  smpId        String?
  smp          SMP?       @relation("SMPTeachers", fields: [smpId], references: [id])
  smaId        String?
  sma          SMA?       @relation("SMATeachers", fields: [smaId], references: [id])

  createdAt    DateTime  @default(now())
}

// ------------------------------------------------------------
// CONTENT: NEWS
// ------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsCategory {
  GENERAL
  PESANTREN
  SMP
  SMA
  ACHIEVEMENT
  ANNOUNCEMENT
  EVENT
  COMPETITION
  EDUCATION
  NATIONAL
}

model News {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  category       NewsCategory
  thumbnailId    String?
  thumbnail      Media?        @relation(fields: [thumbnailId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  content        String        @db.Text
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  galleryImages  Media[]       @relation("NewsGallery")
  seoId          String?       @unique
  seo            Seo?          @relation(fields: [seoId], references: [id])
  comments       Comment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([category, status])
  @@index([slug])
}

model Comment {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  authorName String
  authorEmail String
  body      String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// CONTENT: ANNOUNCEMENTS
// ------------------------------------------------------------

enum AnnouncementCategory {
  GENERAL
  PESANTREN
  SMP
  SMA
  ADMISSION
  HOLIDAY
  COMPETITION
  SCHOLARSHIP
  URGENT
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  category    AnnouncementCategory
  content     String               @db.Text
  status      ContentStatus        @default(DRAFT)
  scheduledAt DateTime?            // supports scheduled publish
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category, status])
}

// ------------------------------------------------------------
// ACHIEVEMENTS
// ------------------------------------------------------------

enum AchievementType {
  ACADEMIC
  NON_ACADEMIC
}

enum AchievementUnit {
  PESANTREN
  SMP
  SMA
}

enum AchievementLevel {
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

model Achievement {
  id          String            @id @default(cuid())
  title       String
  type        AchievementType
  unit        AchievementUnit
  level       AchievementLevel
  winner      String
  year        Int
  description String            @db.Text
  photoMediaId String?
  photo       Media?            @relation(fields: [photoMediaId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([unit, level, year])
}

// ------------------------------------------------------------
// GALLERY
// ------------------------------------------------------------

enum GalleryCategory {
  PESANTREN
  SMP
  SMA
}

model Album {
  id          String          @id @default(cuid())
  title       String
  category    GalleryCategory
  description String?
  coverId     String?
  cover       Media?          @relation("AlbumCover", fields: [coverId], references: [id])
  photos      Media[]         @relation("AlbumPhotos")
  createdAt   DateTime        @default(now())
}

// ------------------------------------------------------------
// FACILITIES
// ------------------------------------------------------------

model Facility {
  id          String    @id @default(cuid())
  name        String
  description String    @db.Text
  location    String
  photoMediaId String?
  photo       Media?    @relation(fields: [photoMediaId], references: [id])

  pesantrenId String?
  pesantren   Pesantren? @relation("PesantrenFacilities", fields: [pesantrenId], references: [id])
  smpId       String?
  smp         SMP?       @relation("SMPFacilities", fields: [smpId], references: [id])
  smaId       String?
  sma         SMA?       @relation("SMAFacilities", fields: [smaId], references: [id])

  createdAt   DateTime  @default(now())
}

// ------------------------------------------------------------
// DOWNLOADS
// ------------------------------------------------------------

enum DownloadCategory {
  ACADEMIC_CALENDAR
  SCHOOL_RULES
  BROCHURE
  REGISTRATION_FORM
  OTHER
}

model DownloadFile {
  id        String           @id @default(cuid())
  title     String
  category  DownloadCategory
  fileUrl   String
  fileType  String           // PDF, DOC
  fileSize  String?
  createdAt DateTime         @default(now())
}

// ------------------------------------------------------------
// ADMISSIONS
// ------------------------------------------------------------

enum AdmissionUnit {
  PESANTREN
  SMP
  SMA
}

enum AdmissionStatus {
  SUBMITTED
  VERIFIED
  TEST_SCHEDULED
  ACCEPTED
  REJECTED
}

model Admission {
  id             String          @id @default(cuid())
  fullName       String
  unit           AdmissionUnit
  parentName     String
  phone          String
  email          String
  address        String          @db.Text
  previousSchool String
  message        String?         @db.Text
  status         AdmissionStatus @default(SUBMITTED)
  createdAt      DateTime        @default(now())
}

// ------------------------------------------------------------
// CONTACT / SETTINGS / MENUS / MEDIA / SEO
// ------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id           String     @id @default(cuid())
  foundationId String     @unique
  foundation   Foundation @relation(fields: [foundationId], references: [id])
  siteName     String
  themeColor   String     @default("#0d3b2e")
  googleMapsEmbed String?
  socialLinks  Json?      // { facebook, instagram, youtube, whatsapp }
  updatedAt    DateTime   @updatedAt
}

model Menu {
  id       String     @id @default(cuid())
  label    String
  href     String?
  order    Int        @default(0)
  parentId String?
  parent   Menu?      @relation("MenuChildren", fields: [parentId], references: [id])
  children Menu[]      @relation("MenuChildren")
}

model Media {
  id         String   @id @default(cuid())
  url        String
  publicId   String?  // Cloudinary public_id
  altText    String?
  mimeType   String?
  width      Int?
  height     Int?
  uploadedAt DateTime @default(now())

  // reverse relations
  foundationLogos Foundation[]  @relation("FoundationLogo")
  pesantrenLogos  Pesantren[]   @relation("PesantrenLogo")
  smpLogos        SMP[]         @relation("SMPLogo")
  smaLogos        SMA[]         @relation("SMALogo")
  chairmen        Chairman[]
  boardMembers    BoardMember[]
  principals      Principal[]
  teachers        Teacher[]
  newsThumbnails  News[]
  newsGalleries   News[]        @relation("NewsGallery")
  achievements    Achievement[]
  facilities      Facility[]
  albumCovers     Album[]       @relation("AlbumCover")
  albumPhotos     Album[]       @relation("AlbumPhotos")
}

model Seo {
  id             String  @id @default(cuid())
  metaTitle      String
  metaDescription String
  ogImage        String?
  canonicalUrl   String?
  jsonLd         Json?
  news           News?
}
